root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 2

[*.cs]
csharp_style_expression_bodied_methods = true:suggestion

[*.{json,sh,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
